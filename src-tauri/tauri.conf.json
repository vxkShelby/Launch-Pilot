{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaunchPilot",
  "version": "0.6.2",
  "identifier": "dev.mmedv.launchpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LaunchPilot",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNDQ0NDdBRDRDRkRFQUUKUldTdTNzL1Vla1JFUXNjZ1R4MHcyVzZEQ3lZQnZDdEZtMVZpYkVPZ1YrbVQwQkhpSEhCWDhaYVIK",
      "endpoints": [
        "https://github.com/vxkShelby/Launch-Pilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
